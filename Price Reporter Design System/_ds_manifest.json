d-icon-usage.card.html","group":"Brand","viewport":"700x170","subtitle":"Orange chevrons carry the brand. Blue squares only in product UI; inline glyphs inherit currentColor.","name":"Icon treatments"},{"path":"guidelines/brand-icons.card.html","group":"Brand","viewport":"700x190","subtitle":"Lucide, 24px grid, 2px stroke — substituted set (the brand guide ships no icon library). 78 glyphs in assets/icons/.","name":"Icon set"},{"path":"guidelines/brand-logo-usage.card.html","group":"Brand","viewport":"700x200","subtitle":"Lockups are dark-text art: on navy, put the color lockup in a white panel or pair the mark with a Roboto wordmark.","name":"Logo on backgrounds"},{"path":"guidelines/brand-logos.card.html","group":"Brand","viewport":"700x200","subtitle":"Horizontal, stacked and mark-only, in color and mono. Straight from the brand guide art.","name":"Logo lockups"},{"path":"guidelines/refresh-theme.card.html","group":"Brand","viewport":"700x230","subtitle":"data-theme=&quot;refresh&quot; — softer corners, quiet shadows, more air. For campaign pages, not the site.","name":"Refresh theme"},{"path":"guidelines/colors-bands.card.html","group":"Colors","viewport":"700x180","subtitle":"The page is a stack of four flat fills: white, grey #E4E3E3, navy #0C4166, hero wash. Nothing else.","name":"Section bands"},{"path":"guidelines/colors-blue.card.html","group":"Colors","viewport":"700x150","subtitle":"#085185 headings/buttons · #007CCE/#005E9C/#00416D hero tiles · #0C4166 navy bands","name":"Blue — primary scale"},{"path":"guidelines/colors-gradients.card.html","group":"Colors","viewport":"700x160","subtitle":"The only gradient in the system: #D8EEFE → #BDDCEF behind the hero. Everything else is a flat fill.","name":"Hero wash"},{"path":"guidelines/colors-neutral.card.html","group":"Colors","viewport":"700x150","subtitle":"#E4E3E3 is the alternating section band; #383838 is the utility bar; #6A6D6E is the brand grey.","name":"Neutrals"},{"path":"guidelines/colors-orange.card.html","group":"Colors","viewport":"700x170","subtitle":"#FF6000 is the SITE accent (numbers, chevrons, rules, CTAs). #FF5624 belongs to the logo artwork only.","name":"Orange — accent scale"},{"path":"guidelines/colors-status.card.html","group":"Colors","viewport":"700x150","subtitle":"Green / amber / red, each with a soft background and a strong text tone.","name":"Semantic status"},{"path":"guidelines/colors-surface.card.html","group":"Colors","viewport":"700x170","subtitle":"Flat fills with 1px keylines. Orange borders mark CTAs; navy keylines box the stats band.","name":"Surfaces & borders"},{"path":"guidelines/colors-text.card.html","group":"Colors","viewport":"700x190","subtitle":"Near-black body, brand-blue headings, orange for links-on-hover and accents.","name":"Text roles"},{"path":"guidelines/colors-tiles.card.html","group":"Colors","viewport":"700x170","subtitle":"Three depths, one per hero column: --tile-1 #007CCE, --tile-2 #005E9C, --tile-3 #00416D. Hover fills orange.","name":"Hero tile blues"},{"path":"guidelines/colors-viz.card.html","group":"Colors","viewport":"700x150","subtitle":"--viz-1 … --viz-6, ordered for catalog and sales dashboards.","name":"Chart sequence"},{"path":"components/core/core.card.html","group":"Components","viewport":"700x420","subtitle":"Square-edged flat controls: solid orange CTA, orange-outline, blue, ghost","name":"Core — buttons, badges, tags, logo"},{"path":"components/data/data.card.html","group":"Components","viewport":"700x300","subtitle":"Bordered table with badges, sorting and a footer bar","name":"Data — order table"},{"path":"components/feedback/feedback.card.html","group":"Components","viewport":"700x330","subtitle":"Inline status, hover labels and the modal shell","name":"Feedback — alerts, tooltip, dialog"},{"path":"components/forms/forms.card.html","group":"Components","viewport":"700x400","subtitle":"Square fields, orange focus, plus the white on-navy variant from the Contact block","name":"Forms — input, select, choice, switch"},{"path":"components/navigation/navigation.card.html","group":"Components","viewport":"700x360","subtitle":"Orange chevron FAQ rows plus in-product tabs and the page trail","name":"Navigation — FAQ accordion, tabs, breadcrumb"},{"path":"components/surfaces/surfaces.card.html","group":"Components","viewport":"700x560","subtitle":"The homepage vocabulary: caps heading, hero tiles, orange numbers, service columns","name":"Surfaces — headings, tiles, stats, services, quote"},{"path":"ui_kits/landing/index.html","group":"Landing","viewport":"1280x860","subtitle":"Direct-response LP in the refresh theme: offer + lead form above the fold, proof bar, sticky CTA","name":"Campaign landing page"},{"path":"ui_kits/portal/index.html","group":"Portal","viewport":"1400x900","subtitle":"Navy sidebar app shell, stat row, order table, catalog sync panel","name":"GSA portal — dashboard"},{"path":"guidelines/elevation.card.html","group":"Spacing","viewport":"700x170","subtitle":"No shadows on marketing surfaces. Separation comes from flat bands, 1px keylines, the 3px orange rule and the 5px black hero rule.","name":"Flatness & rules"},{"path":"guidelines/motion.card.html","group":"Spacing","viewport":"700x170","subtitle":"140ms controls, 200ms surfaces, no bounce, no lift. Hover = color inversion; the orange fill is the signature.","name":"Motion & states"},{"path":"guidelines/spacing-controls.card.html","group":"Spacing","viewport":"700x160","subtitle":"34 / 42 / 50px control heights. Radius is 0 — the site is square-edged; 2–4px exists for app panels only.","name":"Controls & radii"},{"path":"guidelines/spacing-layout.card.html","group":"Spacing","viewport":"700x190","subtitle":"1200px container, 24px gutters, 96px section rhythm; 760px for article measure.","name":"Layout rails"},{"path":"guidelines/spacing-scale.card.html","group":"Spacing","viewport":"700x170","subtitle":"4px base. --space-1 (4) … --space-13 (128).","name":"Spacing scale"},{"path":"guideli