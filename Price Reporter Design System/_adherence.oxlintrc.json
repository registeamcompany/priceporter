      {
        "selector": "JSXOpeningElement[name.name='ValueItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|key|ref|className|style|children)$/]",
        "message": "<ValueItem> doesn't accept that prop. Declared props: title, children."
      }
