        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|suffixIcon|trend|trendDirection|tone|boxed|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, icon, suffixIcon, trend, trendDirection, tone, boxed."
