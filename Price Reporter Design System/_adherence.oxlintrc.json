        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|brand|inverse)$/]",
        "message": "<StatCard> tone must be one of 'accent' | 'brand' | 'inverse'."
